+@triton.jit
+def _map_local_experts_kernel(
+    ids, expert_map, output, count, BLOCK: tl.constexpr
+):
+    offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)
+    global_ids = tl.load(ids + offsets, mask=offsets < count, other=-1)
+    local_ids = tl.load(
+        expert_map + tl.maximum(global_ids, 0),
+        mask=(offsets < count) & (global_ids >= 0),
+        other=-1,
+    )
+    tl.store(output + offsets, local_ids, mask=offsets < count)
+
+
